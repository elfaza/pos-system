generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  cashier
  kitchen
  queue
  customer_facing_display
}

enum OrganizationRole {
  owner
  admin
}

enum OutletRole {
  admin
  cashier
  kitchen
  queue
  customer_facing_display
}

enum CustomerDisplayStatus {
  idle
  active
  paid
}

enum OrderStatus {
  draft
  held
  pending_payment
  paid
  cancelled
  refunded
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum PaymentMethod {
  cash
  qris
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  refunded
}

enum ProductOptionSelectionType {
  single
  multiple
}

enum KitchenOrderStatus {
  received
  preparing
  ready
  completed
}

enum StockMovementType {
  sale_deduction
  adjustment
  waste
  refund_restore
}

enum AccountType {
  asset
  income
  expense
  liability
  equity
}

enum JournalSourceType {
  order
  expense
  cash_movement
  daily_close
}

enum CashMovementType {
  cash_in
  cash_out
}

enum ExpensePaymentSource {
  cash
  qris
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions                Session[]
  orders                  Order[]                  @relation("CashierOrders")
  refunds                 Refund[]                 @relation("RefundApprover")
  stockMovements          StockMovement[]          @relation("StockMovementCreator")
  activityLogs            ActivityLog[]
  journalEntries          JournalEntry[]           @relation("JournalEntryCreator")
  expenses                Expense[]                @relation("ExpenseCreator")
  cashMovements           CashMovement[]           @relation("CashMovementCreator")
  dailyCloses             DailyClose[]             @relation("DailyCloseCloser")
  organizationMemberships OrganizationMembership[]
  outletMemberships       OutletMembership[]

  @@map("users")
}

model Session {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  tokenHash            String    @unique @map("token_hash")
  activeOrganizationId String?   @map("active_organization_id")
  activeOutletId       String?   @map("active_outlet_id")
  expiresAt            DateTime  @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  revokedAt            DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([activeOrganizationId, activeOutletId])
  @@map("sessions")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outlets           Outlet[]
  memberships       OrganizationMembership[]
  outletMemberships OutletMembership[]

  @@map("organizations")
}

model Outlet {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  slug           String
  timeZone       String   @default("Asia/Jakarta") @map("time_zone")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships      OutletMembership[]
  products         OutletProduct[]
  ingredientStocks OutletIngredientStock[]

  @@unique([organizationId, slug])
  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("outlets")
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@index([organizationId, role, isActive])
  @@map("organization_memberships")
}

model OutletMembership {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  outletId       String     @map("outlet_id")
  userId         String     @map("user_id")
  role           OutletRole
  isActive       Boolean    @default(true) @map("is_active")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outlet       Outlet       @relation(fields: [organizationId, outletId], references: [organizationId, id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([outletId, userId])
  @@index([userId, isActive])
  @@index([organizationId, outletId, role, isActive])
  @@map("outlet_memberships")
}

model Category {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  name           String
  slug           String   @unique
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([organizationId, isActive])
  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  organizationId    String?  @map("organization_id")
  categoryId        String   @map("category_id")
  name              String
  sku               String?  @unique
  description       String?
  imageUrl          String?  @map("image_url")
  price             Decimal  @db.Decimal(12, 2)
  costPrice         Decimal? @map("cost_price") @db.Decimal(12, 2)
  trackStock        Boolean  @default(false) @map("track_stock")
  stockQuantity     Decimal? @map("stock_quantity") @db.Decimal(12, 3)
  lowStockThreshold Decimal? @map("low_stock_threshold") @db.Decimal(12, 3)
  isAvailable       Boolean  @default(true) @map("is_available")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category       Category             @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  optionGroups   ProductOptionGroup[]
  ingredients    ProductIngredient[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  outletProducts OutletProduct[]

  @@index([categoryId])
  @@index([organizationId, categoryId])
  @@index([organizationId, isAvailable])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  productId      String   @map("product_id")
  name           String
  sku            String?  @unique
  priceDelta     Decimal  @default(0) @map("price_delta") @db.Decimal(12, 2)
  costDelta      Decimal? @map("cost_delta") @db.Decimal(12, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients ProductIngredient[]
  orderItems  OrderItem[]

  @@index([productId])
  @@index([organizationId, productId])
  @@map("product_variants")
}

model ProductOptionGroup {
  id            String                     @id @default(cuid())
  productId     String                     @map("product_id")
  name          String
  selectionType ProductOptionSelectionType @default(single) @map("selection_type")
  isRequired    Boolean                    @default(false) @map("is_required")
  sortOrder     Int                        @default(0) @map("sort_order")
  isActive      Boolean                    @default(true) @map("is_active")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  product         Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  values          ProductOptionValue[]
  orderSelections OrderItemOptionSelection[]

  @@index([productId])
  @@index([isActive])
  @@map("product_option_groups")
}

model ProductOptionValue {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  name       String
  priceDelta Decimal  @default(0) @map("price_delta") @db.Decimal(12, 2)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  group            ProductOptionGroup                        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  orderSelections  OrderItemOptionSelection[]
  recipes          ProductOptionValueIngredient[]
  replacementRules ProductOptionValueIngredientReplacement[]

  @@index([groupId])
  @@index([isActive])
  @@map("product_option_values")
}

model Ingredient {
  id                String   @id @default(cuid())
  organizationId    String?  @map("organization_id")
  name              String
  sku               String?  @unique
  unit              String
  currentStock      Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  lowStockThreshold Decimal? @map("low_stock_threshold") @db.Decimal(12, 3)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  productIngredients            ProductIngredient[]
  optionValueIngredients        ProductOptionValueIngredient[]
  optionValueReplacementSources ProductOptionValueIngredientReplacement[] @relation("OptionReplacementReplacedIngredient")
  optionValueReplacementTargets ProductOptionValueIngredientReplacement[] @relation("OptionReplacementReplacementIngredient")
  stockMovements                StockMovement[]
  outletStocks                  OutletIngredientStock[]

  @@index([name])
  @@index([isActive])
  @@index([organizationId, isActive])
  @@map("ingredients")
}

model ProductIngredient {
  id               String   @id @default(cuid())
  productId        String   @map("product_id")
  variantId        String?  @map("variant_id")
  ingredientId     String   @map("ingredient_id")
  quantityRequired Decimal  @map("quantity_required") @db.Decimal(12, 3)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  ingredient Ingredient      @relation(fields: [ingredientId], references: [id])

  @@unique([productId, variantId, ingredientId])
  @@index([productId])
  @@index([variantId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

model ProductOptionValueIngredient {
  id               String   @id @default(cuid())
  optionValueId    String   @map("option_value_id")
  ingredientId     String   @map("ingredient_id")
  quantityRequired Decimal  @map("quantity_required") @db.Decimal(12, 3)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  ingredient  Ingredient         @relation(fields: [ingredientId], references: [id])

  @@unique([optionValueId, ingredientId])
  @@index([optionValueId])
  @@index([ingredientId])
  @@map("product_option_value_ingredients")
}

model ProductOptionValueIngredientReplacement {
  id                      String   @id @default(cuid())
  optionValueId           String   @map("option_value_id")
  replacedIngredientId    String   @map("replaced_ingredient_id")
  replacementIngredientId String   @map("replacement_ingredient_id")
  quantityRequired        Decimal  @map("quantity_required") @db.Decimal(12, 3)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  optionValue           ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)
  replacedIngredient    Ingredient         @relation("OptionReplacementReplacedIngredient", fields: [replacedIngredientId], references: [id])
  replacementIngredient Ingredient         @relation("OptionReplacementReplacementIngredient", fields: [replacementIngredientId], references: [id])

  @@unique([optionValueId, replacedIngredientId])
  @@index([optionValueId])
  @@index([replacedIngredientId])
  @@index([replacementIngredientId])
  @@map("product_option_value_ingredient_replacements")
}

model AppSetting {
  id                       String   @id @default(cuid())
  organizationId           String?  @map("organization_id")
  outletId                 String?  @map("outlet_id")
  storeName                String   @map("store_name")
  storeAddress             String?  @map("store_address")
  storePhone               String?  @map("store_phone")
  logoUrl                  String?  @map("logo_url")
  taxEnabled               Boolean  @default(false) @map("tax_enabled")
  taxRate                  Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  serviceChargeEnabled     Boolean  @default(false) @map("service_charge_enabled")
  serviceChargeRate        Decimal  @default(0) @map("service_charge_rate") @db.Decimal(5, 2)
  refundWindowHours        Int?     @map("refund_window_hours")
  autoRestoreStockOnRefund Boolean  @default(false) @map("auto_restore_stock_on_refund")
  receiptFooter            String?  @map("receipt_footer")
  locale                   String   @default("id-ID")
  currencyCode             String   @default("IDR") @map("currency_code")
  timeZone                 String   @default("Asia/Jakarta") @map("time_zone")
  businessDayStartTime     String   @default("00:00") @map("business_day_start_time")
  cashPaymentEnabled       Boolean  @default(true) @map("cash_payment_enabled")
  qrisPaymentEnabled       Boolean  @default(true) @map("qris_payment_enabled")
  dineInPayLaterEnabled    Boolean  @default(false) @map("dine_in_pay_later_enabled")
  kitchenEnabled           Boolean  @default(true) @map("kitchen_enabled")
  queueEnabled             Boolean  @default(true) @map("queue_enabled")
  inventoryEnabled         Boolean  @default(true) @map("inventory_enabled")
  accountingEnabled        Boolean  @default(true) @map("accounting_enabled")
  reportingEnabled         Boolean  @default(true) @map("reporting_enabled")
  receiptPrintingEnabled   Boolean  @default(true) @map("receipt_printing_enabled")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([organizationId, outletId])
  @@map("app_settings")
}

model CustomerDisplayState {
  id              String                @id @default(cuid())
  organizationId  String?               @map("organization_id")
  outletId        String?               @map("outlet_id")
  scopeKey        String                @unique @default("default") @map("scope_key")
  status          CustomerDisplayStatus @default(idle)
  storeName       String                @default("") @map("store_name")
  payload         Json                  @default("{}")
  paidOrderNumber String?               @map("paid_order_number")
  paidAt          DateTime?             @map("paid_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  createdAt       DateTime              @default(now()) @map("created_at")

  @@index([organizationId, outletId])
  @@map("customer_display_states")
}

model Order {
  id                    String              @id @default(cuid())
  organizationId        String?             @map("organization_id")
  outletId              String?             @map("outlet_id")
  orderNumber           String              @map("order_number")
  cashierId             String              @map("cashier_id")
  orderType             OrderType           @default(takeaway) @map("order_type")
  tableId               String?             @map("table_id")
  status                OrderStatus         @default(draft)
  subtotalAmount        Decimal             @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount        Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount             Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  serviceChargeAmount   Decimal             @default(0) @map("service_charge_amount") @db.Decimal(12, 2)
  totalAmount           Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes                 String?
  deliveryCustomerName  String?             @map("delivery_customer_name")
  deliveryCustomerPhone String?             @map("delivery_customer_phone")
  deliveryAddress       String?             @map("delivery_address")
  deliveryNotes         String?             @map("delivery_notes")
  queueBusinessDate     String?             @map("queue_business_date") @db.VarChar(10)
  queueNumber           Int?                @map("queue_number")
  kitchenStatus         KitchenOrderStatus? @map("kitchen_status")
  kitchenPreparingAt    DateTime?           @map("kitchen_preparing_at")
  kitchenReadyAt        DateTime?           @map("kitchen_ready_at")
  kitchenCompletedAt    DateTime?           @map("kitchen_completed_at")
  heldAt                DateTime?           @map("held_at")
  paidAt                DateTime?           @map("paid_at")
  cancelledAt           DateTime?           @map("cancelled_at")
  refundedAt            DateTime?           @map("refunded_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  cashier        User            @relation("CashierOrders", fields: [cashierId], references: [id])
  table          DiningTable?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]
  refunds        Refund[]
  stockMovements StockMovement[]

  @@unique([outletId, orderNumber])
  @@unique([outletId, queueBusinessDate, queueNumber])
  @@index([cashierId])
  @@index([tableId])
  @@index([status])
  @@index([kitchenStatus])
  @@index([organizationId, outletId, status])
  @@index([organizationId, outletId, kitchenStatus])
  @@index([organizationId, outletId, queueBusinessDate])
  @@index([organizationId, outletId, createdAt])
  @@index([organizationId, outletId, paidAt])
  @@index([organizationId, outletId, kitchenReadyAt])
  @@map("orders")
}

model DiningTable {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  outletId       String?  @map("outlet_id")
  name           String
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([isActive])
  @@index([organizationId, outletId, isActive])
  @@unique([outletId, name])
  @@map("dining_tables")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String   @map("order_id")
  productId           String   @map("product_id")
  variantId           String?  @map("variant_id")
  productNameSnapshot String   @map("product_name_snapshot")
  variantNameSnapshot String?  @map("variant_name_snapshot")
  quantity            Decimal  @db.Decimal(12, 3)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal           Decimal  @map("line_total") @db.Decimal(12, 2)
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")

  order            Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product                    @relation(fields: [productId], references: [id])
  variant          ProductVariant?            @relation(fields: [variantId], references: [id])
  optionSelections OrderItemOptionSelection[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemOptionSelection {
  id                String   @id @default(cuid())
  orderItemId       String   @map("order_item_id")
  optionGroupId     String?  @map("option_group_id")
  optionValueId     String?  @map("option_value_id")
  groupNameSnapshot String   @map("group_name_snapshot")
  valueNameSnapshot String   @map("value_name_snapshot")
  priceDelta        Decimal  @default(0) @map("price_delta") @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  orderItem   OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  optionGroup ProductOptionGroup? @relation(fields: [optionGroupId], references: [id], onDelete: SetNull)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionGroupId])
  @@index([optionValueId])
  @@map("order_item_option_selections")
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String        @unique @map("order_id")
  method             PaymentMethod
  status             PaymentStatus @default(pending)
  amount             Decimal       @db.Decimal(12, 2)
  cashReceivedAmount Decimal?      @map("cash_received_amount") @db.Decimal(12, 2)
  changeAmount       Decimal?      @map("change_amount") @db.Decimal(12, 2)
  provider           String?
  providerReference  String?       @map("provider_reference")
  paidAt             DateTime?     @map("paid_at")
  expiresAt          DateTime?     @map("expires_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([status])
  @@map("payments")
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  paymentId        String   @map("payment_id")
  approvedByUserId String   @map("approved_by_user_id")
  amount           Decimal  @db.Decimal(12, 2)
  reason           String
  stockRestored    Boolean  @default(false) @map("stock_restored")
  createdAt        DateTime @default(now()) @map("created_at")

  order      Order   @relation(fields: [orderId], references: [id])
  payment    Payment @relation(fields: [paymentId], references: [id])
  approvedBy User    @relation("RefundApprover", fields: [approvedByUserId], references: [id])

  @@index([orderId])
  @@index([paymentId])
  @@map("refunds")
}

model StockMovement {
  id              String            @id @default(cuid())
  organizationId  String?           @map("organization_id")
  outletId        String?           @map("outlet_id")
  ingredientId    String?           @map("ingredient_id")
  productId       String?           @map("product_id")
  orderId         String?           @map("order_id")
  type            StockMovementType
  quantityChange  Decimal           @map("quantity_change") @db.Decimal(12, 3)
  reason          String?
  createdByUserId String?           @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  ingredient    Ingredient? @relation(fields: [ingredientId], references: [id])
  product       Product?    @relation(fields: [productId], references: [id])
  order         Order?      @relation(fields: [orderId], references: [id])
  createdByUser User?       @relation("StockMovementCreator", fields: [createdByUserId], references: [id])

  @@index([ingredientId])
  @@index([productId])
  @@index([orderId])
  @@index([organizationId, outletId, createdAt])
  @@map("stock_movements")
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  outletId       String?  @map("outlet_id")
  userId         String?  @map("user_id")
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([organizationId, outletId, createdAt])
  @@map("activity_logs")
}

model Account {
  id             String      @id @default(cuid())
  organizationId String?     @map("organization_id")
  code           String
  name           String
  type           AccountType
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  journalLines      JournalEntryLine[]
  expenseCategories ExpenseCategory[]

  @@index([type])
  @@index([isActive])
  @@index([organizationId, type])
  @@unique([organizationId, code])
  @@map("accounts")
}

model JournalEntry {
  id              String            @id @default(cuid())
  organizationId  String?           @map("organization_id")
  outletId        String?           @map("outlet_id")
  entryNumber     String            @map("entry_number")
  sourceType      JournalSourceType @map("source_type")
  sourceId        String            @map("source_id")
  businessDate    String            @map("business_date") @db.VarChar(10)
  description     String
  createdByUserId String?           @map("created_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")

  createdBy User?              @relation("JournalEntryCreator", fields: [createdByUserId], references: [id])
  lines     JournalEntryLine[]

  @@unique([outletId, entryNumber])
  @@unique([outletId, sourceType, sourceId])
  @@index([businessDate])
  @@index([createdByUserId])
  @@index([organizationId, outletId, businessDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String   @map("journal_entry_id")
  accountId      String   @map("account_id")
  debitAmount    Decimal  @default(0) @map("debit_amount") @db.Decimal(12, 2)
  creditAmount   Decimal  @default(0) @map("credit_amount") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  name           String
  accountId      String   @map("account_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  account  Account   @relation(fields: [accountId], references: [id])
  expenses Expense[]

  @@index([accountId])
  @@index([isActive])
  @@index([organizationId, isActive])
  @@unique([organizationId, name])
  @@map("expense_categories")
}

model Expense {
  id              String               @id @default(cuid())
  organizationId  String?              @map("organization_id")
  outletId        String?              @map("outlet_id")
  categoryId      String               @map("category_id")
  amount          Decimal              @db.Decimal(12, 2)
  businessDate    String               @map("business_date") @db.VarChar(10)
  paymentSource   ExpensePaymentSource @map("payment_source")
  description     String
  createdByUserId String               @map("created_by_user_id")
  createdAt       DateTime             @default(now()) @map("created_at")

  category  ExpenseCategory @relation(fields: [categoryId], references: [id])
  createdBy User            @relation("ExpenseCreator", fields: [createdByUserId], references: [id])

  @@index([categoryId])
  @@index([businessDate])
  @@index([createdByUserId])
  @@index([organizationId, outletId, businessDate])
  @@map("expenses")
}

model CashMovement {
  id              String           @id @default(cuid())
  organizationId  String?          @map("organization_id")
  outletId        String?          @map("outlet_id")
  type            CashMovementType
  amount          Decimal          @db.Decimal(12, 2)
  businessDate    String           @map("business_date") @db.VarChar(10)
  reason          String
  createdByUserId String           @map("created_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  createdBy User @relation("CashMovementCreator", fields: [createdByUserId], references: [id])

  @@index([businessDate])
  @@index([createdByUserId])
  @@index([organizationId, outletId, businessDate])
  @@map("cash_movements")
}

model CashLedgerEntry {
  id             String            @id @default(cuid())
  organizationId String?           @map("organization_id")
  outletId       String?           @map("outlet_id")
  sourceType     JournalSourceType @map("source_type")
  sourceId       String            @map("source_id")
  businessDate   String            @map("business_date") @db.VarChar(10)
  direction      String
  amount         Decimal           @db.Decimal(12, 2)
  description    String
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([outletId, sourceType, sourceId])
  @@index([businessDate])
  @@index([organizationId, outletId, businessDate])
  @@map("cash_ledger_entries")
}

model DailyClose {
  id                 String   @id @default(cuid())
  organizationId     String?  @map("organization_id")
  outletId           String?  @map("outlet_id")
  businessDate       String   @map("business_date") @db.VarChar(10)
  expectedCashAmount Decimal  @map("expected_cash_amount") @db.Decimal(12, 2)
  countedCashAmount  Decimal  @map("counted_cash_amount") @db.Decimal(12, 2)
  differenceAmount   Decimal  @map("difference_amount") @db.Decimal(12, 2)
  closedByUserId     String   @map("closed_by_user_id")
  closedAt           DateTime @default(now()) @map("closed_at")

  closedBy User @relation("DailyCloseCloser", fields: [closedByUserId], references: [id])

  @@index([closedByUserId])
  @@index([organizationId, outletId, businessDate])
  @@unique([outletId, businessDate])
  @@map("daily_closes")
}

model OutletProduct {
  id                String   @id @default(cuid())
  outletId          String   @map("outlet_id")
  productId         String   @map("product_id")
  isAvailable       Boolean  @default(true) @map("is_available")
  priceOverride     Decimal? @map("price_override") @db.Decimal(12, 2)
  stockQuantity     Decimal? @map("stock_quantity") @db.Decimal(12, 3)
  lowStockThreshold Decimal? @map("low_stock_threshold") @db.Decimal(12, 3)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  outlet  Outlet  @relation(fields: [outletId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([outletId, productId])
  @@index([productId])
  @@map("outlet_products")
}

model OutletIngredientStock {
  id                String   @id @default(cuid())
  outletId          String   @map("outlet_id")
  ingredientId      String   @map("ingredient_id")
  currentStock      Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  lowStockThreshold Decimal? @map("low_stock_threshold") @db.Decimal(12, 3)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  outlet     Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([outletId, ingredientId])
  @@index([ingredientId])
  @@map("outlet_ingredient_stocks")
}
